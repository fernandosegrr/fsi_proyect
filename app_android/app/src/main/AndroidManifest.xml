<?xml version="1.0" encoding="utf-8"?>
<!--
  Guía de lectura: declara la app y sus pantallas (MainActivity, ControlActivity, BenchmarkActivity).
  Permisos: INTERNET (WebSocket hacia el carro) y CAMARA (detector de obstáculos). networkSecurityConfig permite ws:// sin cifrar.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Necesario para el WebSocket hacia el carro (ControlActivity). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Cámara del teléfono como fuente de obstáculos (VisionActivity y modo semiautónomo). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:label="@string/nombre_app"
        android:theme="@style/TemaApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de control del carro (botones + WebSocket); ver ControlActivity.kt. -->
        <activity
            android:name=".ControlActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!-- Pantalla de visión: cámara + detector de obstáculos con umbrales ajustables (en horizontal). -->
        <activity
            android:name=".VisionActivity"
            android:exported="true"
            android:screenOrientation="landscape" />

        <!-- Asistente de calibración del carro (arranque, avance, giro); ver CalibracionActivity.kt. -->
        <activity
            android:name=".CalibracionActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!-- Benchmark del detector de objetos; se puede abrir con adb (ver BenchmarkActivity.kt). -->
        <activity
            android:name=".BenchmarkActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

    </application>

</manifest>
