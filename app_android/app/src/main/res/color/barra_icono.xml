<?xml version="1.0" encoding="utf-8"?>
<!-- Guía de lectura: color de iconos y texto de la barra inferior: acento si está activo, gris suave si no. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/acento_texto" android:state_checked="true" />
    <item android:color="@color/texto_suave" />
</selector>
