<?xml version="1.0" encoding="utf-8"?>
<!-- Guía de lectura: una fila del menú de «Más»: icono, título, frase de ayuda y flecha. Toda la tarjeta se toca (48 dp o más). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/e1"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/e6"
        android:orientation="horizontal"
        android:padding="@dimen/e2">

        <ImageView
            android:id="@+id/item_icono"
            android:layout_width="@dimen/icono"
            android:layout_height="@dimen/icono"
            android:importantForAccessibility="no"
            app:tint="@color/acento_texto" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/e2"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_titulo"
                style="@style/Texto.Subtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/item_detalle"
                style="@style/Texto.Suave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/icono"
            android:layout_height="@dimen/icono"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/texto_suave" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
