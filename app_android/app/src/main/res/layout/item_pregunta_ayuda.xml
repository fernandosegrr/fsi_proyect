<?xml version="1.0" encoding="utf-8"?>
<!--
  Guía de lectura: una pregunta frecuente de Ayuda. Toda la tarjeta se toca: abre o cierra la respuesta (ay_cuerpo) y cambia el icono (expand_more / expand_less).
  La respuesta tiene dos partes: la primera (qué pasó o qué es) y «Qué hacer».
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/e1"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/e6"
            android:orientation="horizontal"
            android:padding="@dimen/e2">

            <TextView
                android:id="@+id/ay_pregunta"
                style="@style/Texto.Subtitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/ay_icono"
                android:layout_width="@dimen/icono"
                android:layout_height="@dimen/icono"
                android:layout_marginStart="@dimen/e2"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/texto_suave" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ay_cuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/e2"
            android:paddingEnd="@dimen/e2"
            android:paddingBottom="@dimen/e2"
            android:visibility="gone">

            <TextView
                android:id="@+id/ay_etiqueta_1"
                style="@style/Seccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/ay_texto_1"
                style="@style/Texto.Cuerpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/e0" />

            <TextView
                android:id="@+id/ay_etiqueta_2"
                style="@style/Seccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/e2"
                android:text="@string/ay_et_hacer" />

            <TextView
                android:id="@+id/ay_texto_2"
                style="@style/Texto.Cuerpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/e0" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
