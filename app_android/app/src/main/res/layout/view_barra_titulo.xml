<?xml version="1.0" encoding="utf-8"?>
<!-- Guía de lectura: la barra de título de las pantallas que se abren desde «Más»: flecha para volver y el nombre de la pantalla. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/e1"
    android:paddingTop="@dimen/e1"
    android:paddingEnd="@dimen/e2">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/barra_volver"
        style="@style/Boton.Texto"
        android:layout_width="@dimen/toque_minimo"
        android:layout_height="@dimen/toque_minimo"
        android:contentDescription="@string/volver"
        android:minWidth="@dimen/toque_minimo"
        android:paddingStart="12dp"
        android:paddingEnd="0dp"
        app:icon="@drawable/ic_arrow_back"
        app:iconSize="24dp" />

    <TextView
        android:id="@+id/barra_titulo"
        style="@style/Texto.Titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/e1"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1" />
</LinearLayout>
