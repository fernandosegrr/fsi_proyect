<?xml version="1.0" encoding="utf-8"?>
<!-- Guía de lectura: un paso numerado de «Si algo falla» en Ayuda: el número en un círculo y la frase corta. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/e1"
    android:paddingBottom="@dimen/e1">

    <TextView
        android:id="@+id/ay_numero"
        style="@style/Texto.Cifras"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/ay_fondo_numero"
        android:gravity="center" />

    <TextView
        android:id="@+id/ay_paso_texto"
        style="@style/Texto.Cuerpo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/e2"
        android:layout_weight="1" />
</LinearLayout>
