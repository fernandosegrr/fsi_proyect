<?xml version="1.0" encoding="utf-8"?>
<!-- Guía de lectura: el componente ESTADO VACÍO: icono grande suave, una frase de qué pasa y (opcional) un botón con la acción. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/estado_vacio"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/e4">

    <ImageView
        android:id="@+id/vacio_icono"
        android:layout_width="@dimen/e5"
        android:layout_height="@dimen/e5"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_info"
        app:tint="@color/borde_fuerte" />

    <TextView
        android:id="@+id/vacio_texto"
        style="@style/Texto.Cuerpo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/e2"
        android:gravity="center"
        android:textColor="@color/texto_suave" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/vacio_boton"
        style="@style/Boton.Secundario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/e2"
        android:visibility="gone" />
</LinearLayout>
