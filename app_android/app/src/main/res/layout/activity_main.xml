<?xml version="1.0" encoding="utf-8"?>
<!--
  Guía de lectura: pantalla principal, de arriba abajo:
    1. instrucción  2. cuadrícula (CuadriculaView)  3. contador de puntos
    4. botones Calcular / Borrar  5. resultado con scroll.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:fitsSystemWindows="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/instruccion"
        android:textSize="14sp" />

    <com.fsi.carro.CuadriculaView
        android:id="@+id/cuadricula"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/contador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/boton_calcular"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/boton_calcular" />

        <Button
            android:id="@+id/boton_borrar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/boton_borrar" />
    </LinearLayout>

    <Button
        android:id="@+id/boton_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/boton_control" />

    <Button
        android:id="@+id/boton_benchmark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/boton_benchmark" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/resultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/resultado_inicial"
            android:textSize="13sp" />
    </ScrollView>

</LinearLayout>
