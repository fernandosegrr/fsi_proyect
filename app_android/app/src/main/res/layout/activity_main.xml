<?xml version="1.0" encoding="utf-8"?>
<!--
  Guía de lectura: el armazón de la app (vertical): cabecera fija, aviso global, contenido (las pantallas son Fragment) y barra inferior.
  En horizontal (layout-land) la barra pasa a la izquierda.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/view_cabecera" />

    <TextView
        android:id="@+id/camara_prueba"
        style="@style/Texto.Subtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/e1"
        android:text="@string/camara_prueba"
        android:visibility="gone" />

    <com.fsi.carro.AvisoBanda
        android:id="@+id/aviso_global"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/e2"
        android:layout_marginTop="@dimen/e1"
        android:layout_marginEnd="@dimen/e2" />

    <FrameLayout
        android:id="@+id/contenedor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/barra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/barra_inferior"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>
