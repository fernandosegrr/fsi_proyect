<?xml version="1.0" encoding="utf-8"?>
<!--
  Guía de lectura: pantalla del benchmark. Un botón para empezar, una línea de
  estado y el registro de resultados con scroll.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:fitsSystemWindows="true">

    <Button
        android:id="@+id/boton_iniciar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/boton_benchmark_iniciar" />

    <Button
        android:id="@+id/boton_iniciar_obstaculos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/boton_benchmark_obstaculos" />

    <TextView
        android:id="@+id/estado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="14sp" />

    <ScrollView
        android:id="@+id/desplazamiento"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/registro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="10sp" />
    </ScrollView>

</LinearLayout>
