<?xml version="1.0" encoding="utf-8"?>
<!--
  Guía de lectura: el ASISTENTE de primera vez (3 pantallas): un icono grande, el título (lo grande), una frase corta y los puntos de avance.
  Abajo: «Omitir» y el botón primario («Siguiente», y «Empezar» en la última).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    android:paddingStart="@dimen/e3"
    android:paddingTop="@dimen/e3"
    android:paddingEnd="@dimen/e3"
    android:paddingBottom="@dimen/e3">

    <TextView
        android:id="@+id/asistente_paso"
        style="@style/Texto.Etiqueta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/asistente_icono"
            android:layout_width="@dimen/e6"
            android:layout_height="@dimen/e6"
            android:importantForAccessibility="no"
            app:tint="@color/acento_texto" />

        <TextView
            android:id="@+id/asistente_titulo"
            style="@style/Texto.Grande"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/e3" />

        <TextView
            android:id="@+id/asistente_texto"
            style="@style/Texto.Cuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/e2"
            android:textColor="@color/texto_suave" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/asistente_puntos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/e3"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/asistente_omitir"
            style="@style/Boton.Texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/asistente_omitir" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/asistente_siguiente"
            style="@style/Boton.Primario"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/toque_manejo"
            android:minWidth="160dp"
            android:text="@string/asistente_siguiente" />
    </LinearLayout>
</LinearLayout>
