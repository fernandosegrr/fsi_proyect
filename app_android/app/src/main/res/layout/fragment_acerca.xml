<?xml version="1.0" encoding="utf-8"?>
<!--
  Guía de lectura: pantalla ACERCA DE. Lo grande es el nombre de la app; debajo la versión (de PackageManager), una frase del proyecto y la lista
  de licencias de lo incluido (una fila por pieza, se arma en AcercaFragment con item_licencia.xml).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_barra_titulo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fondo"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/e2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingTop="@dimen/e2"
            android:paddingEnd="@dimen/margen_pantalla">

            <ImageView
                android:layout_width="@dimen/e5"
                android:layout_height="@dimen/e5"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_directions_car"
                app:tint="@color/acento_texto" />

            <TextView
                style="@style/Texto.Grande"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/e2"
                android:text="@string/nombre_app" />

            <TextView
                android:id="@+id/ac_version"
                style="@style/Texto.Suave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/e0" />

            <TextView
                style="@style/Texto.Cuerpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/e2"
                android:text="@string/ac_frase" />

            <TextView
                style="@style/Seccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/e4"
                android:layout_marginBottom="@dimen/e1"
                android:text="@string/ac_licencias" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/ac_lista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/e2"
                    android:paddingEnd="@dimen/e2" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Texto.Suave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/e1"
                android:text="@string/ac_licencias_ayuda" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
