<?xml version="1.0" encoding="utf-8"?>
<!--
  Guía de lectura: pantalla EJECUTAR RUTA. Lo grande: el estado en palabras («Avanzando», «Obstáculo: esquivando», «Terminado»). Debajo el progreso por puntos,
  el video del carro, los avisos, «Aprender piso» y el botón de iniciar; mientras la ruta corre el PARO rojo ocupa el lugar del botón de iniciar. Al terminar
  aparece el resumen (resultado, duración y obstáculos esquivados).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <include layout="@layout/view_barra_titulo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/e3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingTop="@dimen/e1"
            android:paddingEnd="@dimen/margen_pantalla">

            <TextView
                android:id="@+id/ej_estado"
                style="@style/Texto.Grande"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ejecutar_estado_listo" />

            <TextView
                android:id="@+id/ej_ruta_nombre"
                style="@style/Texto.Suave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/e0" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/ej_barra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/e1"
                android:max="100"
                app:indicatorColor="@color/acento"
                app:trackColor="@color/superficie_alta"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp" />

            <TextView
                android:id="@+id/ej_progreso"
                style="@style/Texto.Cifras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/e1" />

            <include
                layout="@layout/view_video_manual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/e4"
                android:layout_marginTop="@dimen/e1"
                android:layout_marginEnd="@dimen/e4" />

            <com.fsi.carro.AvisoBanda
                android:id="@+id/ej_aviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/e2" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ej_resumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/e2"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/e2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ejecutar_resumen_resultado" />

                        <com.fsi.carro.ChipEstado
                            android:id="@+id/ej_resumen_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e0" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ejecutar_resumen_duracion" />

                        <TextView
                            android:id="@+id/ej_resumen_duracion"
                            style="@style/Texto.Cifras"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ejecutar_resumen_esquivadas" />

                        <TextView
                            android:id="@+id/ej_resumen_esquivadas"
                            style="@style/Texto.Cifras"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/ej_piso"
                style="@style/Texto.Suave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/e2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ej_aprender"
                style="@style/Boton.Secundario"
                android:layout_width="match_parent"
                android:layout_height="@dimen/toque_minimo"
                android:layout_marginTop="@dimen/e1"
                android:text="@string/ejecutar_aprender" />

            <TextView
                android:id="@+id/ej_aprender_ayuda"
                style="@style/Texto.Etiqueta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/e0"
                android:text="@string/ejecutar_aprender_ayuda" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ej_iniciar"
                style="@style/Boton.Primario"
                android:layout_width="match_parent"
                android:layout_height="@dimen/toque_manejo"
                android:layout_marginTop="@dimen/e2"
                android:text="@string/ejecutar_iniciar"
                app:icon="@drawable/ic_play_arrow"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ej_paro"
                style="@style/Boton.Paro"
                android:layout_width="match_parent"
                android:layout_height="@dimen/paro_cruceta"
                android:layout_marginTop="@dimen/e2"
                android:text="@string/paro"
                android:textSize="20sp"
                android:visibility="gone"
                app:icon="@drawable/ic_stop"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ej_volver"
                style="@style/Boton.Secundario"
                android:layout_width="match_parent"
                android:layout_height="@dimen/toque_minimo"
                android:layout_marginTop="@dimen/e1"
                android:text="@string/ejecutar_volver"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ej_boton_detalles"
                style="@style/Boton.Texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/e2"
                android:text="@string/ejecutar_detalles"
                app:icon="@drawable/ic_expand_more"
                app:iconGravity="end" />

            <TextView
                android:id="@+id/ej_detalles"
                style="@style/Texto.Suave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
