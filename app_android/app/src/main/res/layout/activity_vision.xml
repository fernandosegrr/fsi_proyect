<?xml version="1.0" encoding="utf-8"?>
<!--
  Guía de lectura: pantalla VISIÓN Y DIAGNÓSTICO, en horizontal.
   - Izquierda (lo grande): el cuadro de la cámara con lo que detecta el detector (VistaDeteccion) en una tarjeta de esquinas redondas. Encima, un chip con el estado
     de la cámara (fondo sólido: se lee bien sobre cualquier imagen).
   - Derecha (se desplaza): barra de título con la flecha de volver, aviso en banda si la cámara falla, tarjeta «Detector» (estado, fuente de la cámara),
     el botón primario «Guardar cuadro» y la sección plegable «Avanzado» (cerrada al abrir) con todos los ajustes finos y el botón «Restablecer».
   - Todos los márgenes salen de la cuadrícula de 8 dp; los botones miden 48 dp; los colores son tokens del tema (docs/diseno.md).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    android:orientation="horizontal">

    <!-- El video con la detección -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/e2"
        android:layout_marginTop="@dimen/e1"
        android:layout_marginEnd="@dimen/e1"
        android:layout_marginBottom="@dimen/e1"
        android:layout_weight="3">

        <com.fsi.carro.VistaDeteccion
            android:id="@+id/vista_deteccion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/mas_vision" />

        <com.fsi.carro.ChipEstado
            android:id="@+id/vision_chip_camara"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/e1" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Los controles -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:background="@color/fondo"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/e2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/e1"
            android:paddingEnd="@dimen/e2">

            <include layout="@layout/view_barra_titulo" />

            <com.fsi.carro.AvisoBanda
                android:id="@+id/vision_aviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/e1"
                android:layout_marginTop="@dimen/e1" />

            <!-- Lo esencial: estado del detector y de dónde viene la cámara -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/e1"
                android:layout_marginTop="@dimen/e1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/e2">

                    <TextView
                        style="@style/Texto.Subtitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/vision_detector" />

                    <TextView
                        android:id="@+id/texto_stats"
                        style="@style/Texto.Datos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/e1" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/borde_fino"
                        android:layout_marginTop="@dimen/e2"
                        android:background="@color/borde" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_fuente_video"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/e1"
                        android:text="@string/vision_fuente_carro"
                        android:textAppearance="@style/Texto.Cuerpo" />

                    <TextView
                        style="@style/Texto.Suave"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/vision_fuente_ayuda" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- El único botón primario -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/boton_guardar_cuadro"
                style="@style/Boton.Primario"
                android:layout_width="match_parent"
                android:layout_height="@dimen/toque_minimo"
                android:layout_marginStart="@dimen/e1"
                android:layout_marginTop="@dimen/e2"
                android:text="@string/boton_guardar_cuadro"
                app:icon="@drawable/ic_save"
                app:iconGravity="textStart" />

            <!-- AVANZADO: plegable, cerrado al abrir la pantalla -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/e1"
                android:layout_marginTop="@dimen/e2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/avanzado_encabezado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="@string/vision_avanzado_cerrado"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/toque_manejo"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/e2"
                        android:paddingEnd="@dimen/e2">

                        <TextView
                            style="@style/Texto.Subtitulo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/vision_avanzado" />

                        <ImageView
                            android:id="@+id/avanzado_icono"
                            android:layout_width="@dimen/icono"
                            android:layout_height="@dimen/icono"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_expand_more"
                            app:tint="@color/texto_suave" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/avanzado_contenido"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/e2"
                        android:paddingEnd="@dimen/e2"
                        android:paddingBottom="@dimen/e2"
                        android:visibility="gone">

                        <!-- Detección del piso -->
                        <TextView
                            style="@style/Seccion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/vision_seccion_piso" />

                        <TextView
                            android:id="@+id/texto_umbral"
                            style="@style/Texto.Cuerpo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e1" />

                        <SeekBar
                            android:id="@+id/barra_umbral"
                            style="@style/Deslizador"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/toque_minimo" />

                        <TextView
                            android:id="@+id/texto_min_celdas"
                            style="@style/Texto.Cuerpo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e1" />

                        <SeekBar
                            android:id="@+id/barra_min_celdas"
                            style="@style/Deslizador"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/toque_minimo" />

                        <TextView
                            android:id="@+id/texto_fila_minima"
                            style="@style/Texto.Cuerpo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e1" />

                        <SeekBar
                            android:id="@+id/barra_fila_minima"
                            style="@style/Deslizador"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/toque_minimo" />

                        <TextView
                            android:id="@+id/texto_grupos"
                            style="@style/Texto.Cuerpo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e1" />

                        <SeekBar
                            android:id="@+id/barra_grupos"
                            style="@style/Deslizador"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/toque_minimo" />

                        <TextView
                            android:id="@+id/texto_aprendizaje"
                            style="@style/Texto.Cuerpo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e1" />

                        <SeekBar
                            android:id="@+id/barra_aprendizaje"
                            style="@style/Deslizador"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/toque_minimo" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/boton_aprender_piso"
                            style="@style/Boton.Secundario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e1"
                            android:text="@string/vision_aprender_piso" />

                        <TextView
                            android:id="@+id/texto_piso_aprendido"
                            style="@style/Texto.Datos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e1" />

                        <!-- Modelo de objetos -->
                        <TextView
                            style="@style/Seccion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e3"
                            android:text="@string/vision_seccion_modelo" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_modelo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e1"
                            android:text="@string/vision_sw_modelo"
                            android:textAppearance="@style/Texto.Cuerpo" />

                        <TextView
                            android:id="@+id/texto_fusion"
                            style="@style/Texto.Datos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_cualquiera"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e1"
                            android:text="@string/vision_sw_cualquiera"
                            android:textAppearance="@style/Texto.Cuerpo" />

                        <TextView
                            android:id="@+id/texto_cualquiera"
                            style="@style/Texto.Suave"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <SeekBar
                            android:id="@+id/barra_cualquiera"
                            style="@style/Deslizador"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/toque_minimo" />

                        <!-- Trayectoria -->
                        <TextView
                            style="@style/Seccion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e3"
                            android:text="@string/vision_seccion_trayectoria" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_corredor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e1"
                            android:text="@string/vision_sw_corredor"
                            android:textAppearance="@style/Texto.Cuerpo" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Campo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e1"
                            android:hint="@string/vision_corredor_campo"
                            app:helperText="@string/vision_corredor_ayuda">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/campo_corredor"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="text"
                                android:maxLines="1"
                                android:textAppearance="@style/Texto.Cuerpo" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/texto_corredor"
                            style="@style/Texto.Datos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e1" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_flujo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e1"
                            android:text="@string/vision_sw_flujo"
                            android:textAppearance="@style/Texto.Cuerpo" />

                        <!-- Video y cuadro -->
                        <TextView
                            style="@style/Seccion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e3"
                            android:text="@string/vision_seccion_video" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/boton_modo_video"
                            style="@style/Boton.Secundario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e1" />

                        <TextView
                            android:id="@+id/texto_video"
                            style="@style/Texto.Datos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/boton_tamano"
                            style="@style/Boton.Secundario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e1" />

                        <!-- Giro visual -->
                        <TextView
                            style="@style/Seccion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e3"
                            android:text="@string/vision_seccion_giro" />

                        <TextView
                            android:id="@+id/texto_giro"
                            style="@style/Texto.Datos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/boton_giro_cero"
                            style="@style/Boton.Texto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e1"
                            android:text="@string/vision_giro_cero" />

                        <TextView
                            style="@style/Texto.Suave"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/vision_giro_ayuda" />

                        <!-- Restablecer -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/borde_fino"
                            android:layout_marginTop="@dimen/e3"
                            android:background="@color/borde" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/boton_restablecer"
                            style="@style/Boton.Secundario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e2"
                            android:text="@string/vision_restablecer"
                            app:icon="@drawable/ic_refresh"
                            app:iconGravity="textStart" />

                        <TextView
                            style="@style/Texto.Suave"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/e1"
                            android:text="@string/vision_restablecer_ayuda" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cómo leer la imagen -->
            <TextView
                style="@style/Texto.Suave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/e1"
                android:layout_marginTop="@dimen/e2"
                android:text="@string/ayuda_vision" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
