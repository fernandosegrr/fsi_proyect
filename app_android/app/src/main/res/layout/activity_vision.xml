<?xml version="1.0" encoding="utf-8"?>
<!--
  Guía de lectura: pantalla de visión, en horizontal. A la izquierda el cuadro de la cámara con lo
  que detecta el detector (VistaDeteccion). A la derecha los datos (cuadros por segundo, ms por
  cuadro, cámara) y los controles: barras de UMBRAL_COLOR y MIN_CELDAS, guardar cuadro y restablecer.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:fitsSystemWindows="true">

    <com.fsi.carro.VistaDeteccion
        android:id="@+id/vista_deteccion"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/texto_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/texto_umbral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/barra_umbral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/texto_min_celdas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/barra_min_celdas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/boton_guardar_cuadro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/boton_guardar_cuadro" />

            <Button
                android:id="@+id/boton_restablecer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/boton_restablecer" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ayuda_vision"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
