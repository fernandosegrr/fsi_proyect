<?xml version="1.0" encoding="utf-8"?>
<!--
  Guía de lectura: pantalla CALIBRAR EL GIRO CON EL GIROSCOPIO (se abre desde la lista de Calibración), en vertical.
   - Arriba: barra de título con la flecha de volver.
   - En medio (se desplaza): una tarjeta con la explicación y el botón «Empezar» (lo toca el usuario, con el carro quieto y ~1 m libre), el avance («Giro 3 de 6») y, al terminar, el resultado:
     cuánto cambió cada lado contra lo guardado (con un aviso si pasó de 10 %) y el botón «Deshacer» para volver a la calibración anterior.
   - Abajo, SIEMPRE visible: el botón PARO.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/view_barra_titulo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fondo"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/e2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingTop="@dimen/e2"
            android:paddingEnd="@dimen/margen_pantalla">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/e2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Texto.Subtitulo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/e1"
                            android:layout_weight="1"
                            android:text="@string/cg_titulo_tarjeta" />

                        <com.fsi.carro.ChipEstado
                            android:id="@+id/cg_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        style="@style/Texto.Suave"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/e1"
                        android:text="@string/cg_explicacion" />

                    <TextView
                        android:id="@+id/cg_estado"
                        style="@style/Texto.Cifras"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/e2" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/cg_progreso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/e1"
                        android:max="6" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cg_empezar"
                        style="@style/Boton.Primario"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/toque_minimo"
                        android:layout_marginTop="@dimen/e2"
                        android:text="@string/cg_empezar" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cg_tarjeta_resultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/e3"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/e2">

                    <TextView
                        style="@style/Texto.Subtitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cg_resultado" />

                    <TextView
                        android:id="@+id/cg_texto_resultado"
                        style="@style/Texto.Cifras"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/e1" />

                    <TextView
                        android:id="@+id/cg_texto_aviso"
                        style="@style/Texto.Cuerpo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/e1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cg_deshacer"
                        style="@style/Boton.Secundario"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/toque_minimo"
                        android:layout_marginTop="@dimen/e2"
                        android:text="@string/cg_deshacer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cg_paro"
        style="@style/Boton.Paro"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toque_manejo"
        android:layout_marginStart="@dimen/e2"
        android:layout_marginTop="@dimen/e1"
        android:layout_marginEnd="@dimen/e2"
        android:layout_marginBottom="@dimen/e1"
        android:text="@string/paro"
        app:icon="@drawable/ic_stop"
        app:iconGravity="textStart" />
</LinearLayout>
